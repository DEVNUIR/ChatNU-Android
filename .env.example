# ChatNU local server configuration
POSTGRES_PASSWORD=chatnu-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
MINIO_ACCESS_KEY=chatnu
MINIO_SECRET_KEY=replace-this-minio-secret
MINIO_BUCKET=chatnu-attachments
ACCESS_TOKEN_TTL_SECONDS=900
CORS_ORIGIN=*
MAX_UPLOAD_BYTES=26214400

# Android client (used by app/build.gradle.kts when provided as a Gradle property/environment override)
CHATNU_API_URL=http://10.0.2.2:3000/
CHATNU_WS_URL=ws://10.0.2.2:3000/realtime
