# ChatNU server configuration
POSTGRES_PASSWORD=replace-with-a-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
CORS_ORIGIN=*
MAX_UPLOAD_BYTES=26214400

# WebRTC / Coturn. TURN_HOST must be the public DNS name or IP reachable by phones.
TURN_HOST=turn.example.com
TURN_PORT=3478
TURN_REALM=chatnu
TURN_SHARED_SECRET=replace-with-a-random-turn-shared-secret
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_DETECT_EXTERNAL_IP=yes

# Optional FCM service-account JSON, encoded as one-line base64.
# Push contains only IDs/state, never encrypted message plaintext.
FIREBASE_SERVICE_ACCOUNT_B64=

# Android client build overrides
CHATNU_API_URL=https://api.example.com/
CHATNU_WS_URL=wss://api.example.com/realtime

# Optional Firebase Android client config. Leave all four blank for a build without FCM push.
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=

# Release signing. Keep the keystore and passwords outside Git.
CHATNU_KEYSTORE_PATH=/absolute/path/to/chatnu-release.jks
CHATNU_KEYSTORE_PASSWORD=
CHATNU_KEY_ALIAS=chatnu
CHATNU_KEY_PASSWORD=
