{
  "name": "chatnu-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "cors": "2.8.5",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.1.0",
    "ioredis": "5.11.1",
    "jose": "6.2.9",
    "multer": "2.2.0",
    "prisma": "6.19.3",
    "ws": "8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "2.2.0",
    "@types/node": "^22.17.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
