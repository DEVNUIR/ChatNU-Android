generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VOICE
  FILE
  LOCATION
  LIVE_LOCATION
  VIEW_ONCE_IMAGE
  VIEW_ONCE_VIDEO
  SYSTEM
}

model User {
  id                   String               @id @default(cuid())
  username             String               @unique
  displayName          String
  passwordHash         String
  recoveryCodeHash     String
  avatarUrl            String?
  bio                   String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  lastSeenAt           DateTime             @default(now())
  devices              Device[]
  memberships          ConversationMember[]
  createdConversations Conversation[]       @relation("ConversationCreator")
  sentMessages         Message[]            @relation("MessageSender")
  attachments          Attachment[]

  @@index([username])
}

model Device {
  id                String    @id @default(cuid())
  userId            String
  name              String
  identityPublicKey String?
  pushToken         String?   @unique
  pushUpdatedAt     DateTime?
  refreshTokenHash  String?
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  revokedAt         DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id          String               @id @default(cuid())
  type        ConversationType
  title       String?
  avatarUrl   String?
  directKey   String?              @unique
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   User                 @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     ConversationMember[]
  messages    Message[]
  attachments Attachment[]

  @@index([updatedAt])
}

model ConversationMember {
  conversationId String
  userId         String
  role           MemberRole @default(MEMBER)
  joinedAt       DateTime   @default(now())
  lastReadAt     DateTime   @default(now())
  isMuted        Boolean    @default(false)
  isPinned       Boolean    @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String       @id @default(cuid())
  clientId        String?
  conversationId  String
  senderId        String
  type            MessageType  @default(TEXT)
  ciphertext      String
  nonce           String?
  protocolVersion String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
}

model Attachment {
  id             String       @id @default(cuid())
  conversationId String
  ownerId        String
  objectKey      String       @unique
  contentType    String
  sizeBytes      Int
  fileName       String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([ownerId])
}
