PORT=3000
DATABASE_URL=postgresql://chatnu:change-me@postgres:5432/chatnu?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
CORS_ORIGIN=*
ATTACHMENT_DIR=/data/attachments
MAX_UPLOAD_BYTES=26214400

# Optional FCM service-account JSON, raw JSON or one-line base64.
FIREBASE_SERVICE_ACCOUNT_B64=

# Optional TURN REST credentials. TURN_HOST must be publicly reachable by clients.
TURN_HOST=
TURN_PORT=3478
TURN_SHARED_SECRET=replace-with-a-random-turn-shared-secret
TURN_REALM=chatnu
